# ─── LLM Provider ────────────────────────────────────────────────────────────
# LLM_PROVIDER=ollama   → conecta direto ao Ollama (recomendado para cluster)
# LLM_PROVIDER=litellm  → usa LiteLLM como proxy (padrão para backward compat)
LLM_PROVIDER=ollama

# ─── Ollama direto (LLM_PROVIDER=ollama) ─────────────────────────────────────
# Endereço do seu Ollama no cluster
OLLAMA_BASE_URL=http://ollama.seu-cluster.local:11434
# Modelo a usar — deve estar instalado no Ollama (GET /api/tags lista os disponíveis)
OLLAMA_MODEL=llama3.2:3b
# Bearer token se o Ollama estiver protegido (deixe vazio caso contrário)
OLLAMA_API_KEY=

# ─── LiteLLM proxy (LLM_PROVIDER=litellm) ────────────────────────────────────
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MODEL=ollama/llama3.2:3b
LITELLM_API_KEY=

# ─── Timeout de LLM (vale para qualquer provider) ────────────────────────────
LLM_TIMEOUT_MS=60000

# ─── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_token_here
GITHUB_USERNAME=your_github_username_here

# ─── Web server ───────────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
CONTROL_API_TOKEN=

# ─── Database ─────────────────────────────────────────────────────────────────
DB_PATH=data/pac-memory.db

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Learning (RSS) ───────────────────────────────────────────────────────────
LEARNING_INTERVAL_HOURS=6
LEARNING_RSS_SOURCES=
LEARNING_ALLOWED_DOMAINS=
LEARNING_ALLOW_HTTP=false
LEARNING_FETCH_TIMEOUT_MS=15000
LEARNING_MAX_BYTES=1048576
LEARNING_MAX_ITEMS_PER_SOURCE=20

# ─── Evolution ────────────────────────────────────────────────────────────────
EVOLUTION_INTERVAL_HOURS=24
