# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Opções: ollama (padrão) | openai | anthropic | google | litellm
LLM_PROVIDER=ollama

# ─── Configuração unificada (sobrescreve config individual abaixo) ─────────────
# LLM_MODEL=llama3.2:3b        # modelo unificado (opcional, usa default do provider)
# LLM_BASE_URL=http://...      # base URL (para ollama e litellm)
# LLM_API_KEY=                 # chave API (para cloud providers)

# ─── Ollama (LLM_PROVIDER=ollama) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_API_KEY=
OLLAMA_EMBED_MODEL=nomic-embed-text   # modelo de embeddings local

# ─── LiteLLM proxy (LLM_PROVIDER=litellm) ────────────────────────────────────
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MODEL=ollama/llama3.2:3b
LITELLM_API_KEY=
LITELLM_EMBED_MODEL=nomic-embed-text

# ─── OpenAI (LLM_PROVIDER=openai) ────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Anthropic (LLM_PROVIDER=anthropic) ──────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── Google Gemini (LLM_PROVIDER=google) ─────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# ─── Timeout de LLM (vale para qualquer provider) ────────────────────────────
LLM_TIMEOUT_MS=60000

# ─── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_token_here
GITHUB_USERNAME=your_github_username_here

# ─── Web server ───────────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
CONTROL_API_TOKEN=

# ─── Database ─────────────────────────────────────────────────────────────────
DB_PATH=data/pac-memory.db

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Learning (RSS) ───────────────────────────────────────────────────────────
LEARNING_INTERVAL_HOURS=6
LEARNING_RSS_SOURCES=        # URLs separadas por vírgula (adiciona aos defaults)
LEARNING_ALLOWED_DOMAINS=    # domínios extras liberados para fetch
LEARNING_ALLOW_HTTP=false
LEARNING_FETCH_TIMEOUT_MS=15000
LEARNING_MAX_BYTES=1048576
LEARNING_MAX_ITEMS_PER_SOURCE=20

# --- AI/LLM paper aggregation ---
PAPER_AGGREGATOR_ENABLED=true
PAPER_AGGREGATOR_MAX_ITEMS=50
PAPER_AGGREGATOR_QUERY=cat:cs.AI OR cat:cs.CL OR cat:cs.LG OR cat:stat.ML

# --- IA Know publication ---
IA_KNOW_REPO_URL=https://github.com/juninmd/ia-know.git
IA_KNOW_REPO_PATH=temp/ia-know
IA_KNOW_AUTO_PUBLISH=false
IA_KNOW_AUTO_PUSH=true

# ─── Evolution ────────────────────────────────────────────────────────────────
EVOLUTION_INTERVAL_HOURS=24

# ─── Fast-News Integration ──────────────────────────────────────────────────
FAST_NEWS_API_URL=http://fast-news-backend:3001

# ─── Daily Digest ───────────────────────────────────────────────────────────
DAILY_DIGEST_HOUR=7
