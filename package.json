{
  "name": "pac-memory",
  "version": "1.0.0",
  "description": "Autonomous Knowledge & Self-Evolution System",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "pac-memory": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "start": "node dist/cli/index.js start",
    "dev": "tsx src/cli/index.ts start",
    "dev:web": "tsx src/cli/index.ts web",
    "dev:collect": "tsx src/cli/index.ts collect",
    "dev:status": "tsx src/cli/index.ts status",
    "dev:evolve": "tsx src/cli/index.ts evolve",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "autonomous",
    "knowledge",
    "ai",
    "self-evolving"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@fastify/static": "^9.1.1",
    "@fastify/websocket": "^11.2.0",
    "@google/adk": "^0.6.1",
    "@octokit/rest": "^22.0.1",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rss-parser": "^3.13.0",
    "systeminformation": "^5.31.5",
    "yargs": "^18.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
