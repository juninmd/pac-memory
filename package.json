{
  "name": "pac-memory",
  "version": "1.0.0",
  "description": "Autonomous Knowledge & Self-Evolution System",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "pac-memory": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-web-public.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "start": "node dist/cli/index.js start",
    "dev": "tsx src/cli/index.ts start",
    "dev:web": "tsx src/cli/index.ts web",
    "dev:collect": "tsx src/cli/index.ts collect",
    "dev:learn": "tsx src/cli/index.ts learn",
    "dev:status": "tsx src/cli/index.ts status",
    "dev:evolve": "tsx src/cli/index.ts evolve",
    "dev:insights": "tsx src/cli/index.ts insights",
    "dev:export": "tsx src/cli/index.ts export",
    "dev:mcp": "tsx src/cli/index.ts mcp",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "autonomous",
    "knowledge",
    "ai",
    "self-evolving"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "zod@>=4.0.0 <5.0.0": "4.6.7",
      "tar@<7.5.21": "^7.5.21",
      "mariadb@>=3.0.0 <3.5.4": "^3.5.4",
      "mysql2@<3.23.1": "^3.23.1",
      "@mikro-orm/knex@<6.6.14": "^6.6.14",
      "@opentelemetry/core@>=2.0.0 <2.8.0": "^2.8.0",
      "@tootallnate/once@<2.0.1": "^2.0.1"
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/openai": "^3.0.64",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.2.0",
    "@google/adk": "^0.6.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@octokit/rest": "^22.0.1",
    "ai": "^6.0.193",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.8",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rss-parser": "^3.13.0",
    "systeminformation": "^5.33.23",
    "yargs": "^18.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
